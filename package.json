{
  "name": "ens-ideas-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build:site": "CLOUDFLARE=1 pnpm --filter ./site run build",
    "deploy": "pnpm run build:site && alchemy deploy --env-file .env",
    "run": "alchemy run --env-file .env",
    "dev": "alchemy dev --env-file .env",
    "destroy": "alchemy destroy --env-file .env"
  },
  "devDependencies": {
    "alchemy": "0.93.12"
  }
}
